# Backend URL the browser will call (must be reachable from users' machines, not Docker-internal hostnames).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Production example (replace with your server IP or domain):
# NEXT_PUBLIC_API_BASE_URL=http://51.20.18.111:8000
# API_BASE_URL=http://51.20.18.111:8000
#
# API_BASE_URL is read at container runtime and injected into every page.
# NEXT_PUBLIC_API_BASE_URL is still required at `docker compose build` time.
