# Backend URL the browser will call (must be reachable from users' machines).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Vercel / production (set the same values in Vercel → Project → Settings → Environment Variables):
# NEXT_PUBLIC_API_BASE_URL=http://51.20.18.111:8000
# API_BASE_URL=http://51.20.18.111:8000
#
# API_BASE_URL is read on the server and injected into each page at runtime.
# NEXT_PUBLIC_API_BASE_URL is also used for client-side fallbacks.
